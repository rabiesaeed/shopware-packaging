{% sw_extends '@Storefront/storefront/component/product/card/action.html.twig' %}

{% block component_product_box_action_buy %}
    {% set ecommerceEventsActive = config('StapeConversionTracking.config.ecommerceEventsActive') %}
    {% set customerDataEventsActive = config('StapeConversionTracking.config.customerDataEventsActive') %}

    {% set customer = context.customer|default(null) %}
    {% set billingAddress = customer ? customer.defaultBillingAddress : null %}
    {% set productImageUrl = product.cover and product.cover.media ? product.cover.media.url : '' %}
    {% set productManufacturer = product.manufacturer ? product.manufacturer.name : '' %}

    {% set options = {
        'customerDataEventsActive': customerDataEventsActive,
        'customerDefined': customer ? true : false,
        'currency': context.currency.isoCode,
        'productPrice': product.calculatedPrice.totalPrice,
        'productImageURL': productImageUrl,
        'productManufacturer': productManufacturer,
        'productId': product.productNumber,
        'productName': product.translated.name,
        'productQuantity': product.minPurchase,
        'userData': {
            'city': billingAddress ? billingAddress.city : '',
            'country': billingAddress and billingAddress.country ? billingAddress.country.name : '',
            'customer_id': customer ? customer.customerNumber : '',
            'email': customer ? customer.email : '',
            'first_name': customer ? customer.firstName : '',
            'last_name': customer ? customer.lastName : '',
            'phone': customer ? customer.phone : '',
            'region': billingAddress and billingAddress.countryState ? billingAddress.countryState.name : '',
            'street': billingAddress ? billingAddress.street : '',
            'zip': billingAddress ? billingAddress.zipcode : ''
        }
    } %}

    <form action="{{ path('frontend.checkout.line-item.add') }}"
          method="post"
          class="buy-widget"
          {% if ecommerceEventsActive %}data-stape-add-to-cart-options="{{ options|json_encode|e('html_attr') }}"{% endif %}
          data-add-to-cart="true">
        {% block component_product_box_action_form %}
            {{ parent() }}
        {% endblock %}
    </form>
{% endblock %}
