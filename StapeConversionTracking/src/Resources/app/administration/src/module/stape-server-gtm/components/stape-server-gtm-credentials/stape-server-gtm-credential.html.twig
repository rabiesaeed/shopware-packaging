<div class="stape-server-gtm-config-credentials">
<sw-card
                position-identifier="stape-server-gtm-credentials"
                :title="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.cardTitle')"
            >
<sw-container>
<div v-if="actualConfigData" class="card-pointe-settings-credentials-fields">
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.snippetActive']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.snippetActive']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-checkbox-field
                                                name="StapeConversionTracking.config.snippetActive"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.snippetActive.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.snippetActive.tooltipText')"
                                                :disabled="props.isInherited"
                                                :value="props.currentValue"
                                                @update:value="gtmSnippetUpdate"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.snippetId']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.snippetId']"
                                        :customInheritationCheckFunction="checkTextFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-text-field
                                                name="StapeConversionTracking.config.snippetId"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.snippetId.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.snippetId.tooltipText')"
                                                :disabled="props.isInherited"
                                                :value="props.currentValue"
                                                validation="required"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.customDomainActive']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.customDomainActive']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-checkbox-field
                                                name="StapeConversionTracking.config.customDomainActive"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customDomainActive.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customDomainActive.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.snippetActive'] || !actualConfigData['StapeConversionTracking.config.snippetId']"
                                                :value="props.currentValue"
                                                @update:value="customDomainUpdate"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.customDomain']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.customDomain']"
                                        :customInheritationCheckFunction="checkTextFieldInheritance"
                                    >
                                        <template #content="props">
                                            <div
                                                v-html="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customDomain.label')"
                                                class="sw-field__custom-label"
                                            />

                                            <sw-text-field
                                                name="StapeConversionTracking.config.customDomain"
                                                :mapInheritance="props"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customDomain.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.snippetActive'] || !actualConfigData['StapeConversionTracking.config.snippetId']"
                                                :value="props.currentValue"
                                                validation="required"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.customLoaderActive']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.customLoaderActive']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-checkbox-field
                                                name="StapeConversionTracking.config.customLoaderActive"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customLoaderActive.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customLoaderActive.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.snippetActive'] || !actualConfigData['StapeConversionTracking.config.snippetId'] || !actualConfigData['StapeConversionTracking.config.customDomainActive'] || !actualConfigData['StapeConversionTracking.config.customDomain']"
                                                :value="props.currentValue"
                                                @update:value="customLoaderUpdate"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.customLoader']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.customLoader']"
                                        :customInheritationCheckFunction="checkTextFieldInheritance"
                                    >
                                        <template #content="props">
                                            <div
                                                v-html="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customLoader.label')"
                                                class="sw-field__custom-label"
                                            />

                                            <sw-text-field
                                                name="StapeConversionTracking.config.customLoader"
                                                :mapInheritance="props"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customLoader.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.snippetActive'] || !actualConfigData['StapeConversionTracking.config.snippetId'] || !actualConfigData['StapeConversionTracking.config.customDomainActive'] || !actualConfigData['StapeConversionTracking.config.customDomain']"
                                                :value="props.currentValue"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.cookieKeeper']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.cookieKeeper']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-checkbox-field
                                                name="StapeConversionTracking.config.cookieKeeper"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.cookieKeeper.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.cookieKeeper.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.snippetActive'] || !actualConfigData['StapeConversionTracking.config.snippetId'] || !actualConfigData['StapeConversionTracking.config.customDomainActive'] || !actualConfigData['StapeConversionTracking.config.customDomain'] || !actualConfigData['StapeConversionTracking.config.customLoaderActive'] || !actualConfigData['StapeConversionTracking.config.customLoader']"
                                                :value="props.currentValue"
                                                @update:value="props.updateCurrentValue"
                                            />

                                            <div
                                                v-html="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.cookieKeeper.info')"
                                                class="sw-field__custom-label stape-cookie-keeper-info"
                                            />
                                        </template>
	                                    </sw-inherit-wrapper>
		<sw-textarea-field
		                                        name="StapeConversionTracking.config.customLoaderScript"
		                                        class="stape-custom-loader-script"
	                                        :label="$tc('stape-server-gtm.settingForm.credentials.gtmSnippet.customLoaderScript.label')"
	                                        :value="actualConfigData['StapeConversionTracking.config.customLoaderScript'] || ''"
	                                        :disabled="true"
	                                    />
	</div>
</sw-container>
</sw-card>
<sw-card
                position-identifier="stape-server-gtm-credentials-data-layer"
                :title="$tc('stape-server-gtm.settingForm.credentials.dataLayer.cardTitle')"
            >
<sw-container>
<div v-if="actualConfigData" class="card-pointe-settings-credentials-fields">
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.ecommerceEventsActive']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.ecommerceEventsActive']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-switch-field
                                                name="StapeConversionTracking.config.ecommerceEventsActive"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.dataLayer.ecommerceEvents.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.dataLayer.ecommerceEvents.tooltipText')"
                                                :disabled="props.isInherited"
                                                :value="props.currentValue"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.customerDataEventsActive']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.customerDataEventsActive']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-switch-field
                                                name="StapeConversionTracking.config.customerDataEventsActive"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.dataLayer.userDataEvents.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.dataLayer.userDataEvents.tooltipText')"
                                                :disabled="props.isInherited"
                                                :value="props.currentValue"
                                                validation="required"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
</div>
</sw-container>
</sw-card>
<sw-card
                position-identifier="stape-server-gtm-credentials-web-hooks"
                :title="$tc('stape-server-gtm.settingForm.credentials.webHooks.cardTitle')"
            >
<sw-container>
<div v-if="actualConfigData" class="card-pointe-settings-credentials-fields">
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.sendWebhooks']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.sendWebhooks']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-checkbox-field
                                                name="StapeConversionTracking.config.sendWebhooks"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.webHooks.sendWebhooks.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.webHooks.sendWebhooks.tooltipText')"
                                                :disabled="props.isInherited"
                                                :value="props.currentValue"
                                                @update:value="webhookUpdate"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.serverContainerUrl']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.serverContainerUrl']"
                                        :customInheritationCheckFunction="checkTextFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-text-field
                                                name="StapeConversionTracking.config.serverContainerUrl"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.webHooks.serverContainerUrl.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.webHooks.serverContainerUrl.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.sendWebhooks']"
                                                :value="props.currentValue"
                                                validation="required"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.purchaseWebhook']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.purchaseWebhook']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-checkbox-field
                                                name="StapeConversionTracking.config.purchaseWebhook"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.webHooks.purchaseWebhook.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.webHooks.purchaseWebhook.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.sendWebhooks']"
                                                :value="props.currentValue"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-inherit-wrapper
                                        v-model:value="actualConfigData['StapeConversionTracking.config.refundWebhook']"
                                        :inheritedValue="selectedSalesChannelId === null ? null : allConfigs['null']['StapeConversionTracking.config.refundWebhook']"
                                        :customInheritationCheckFunction="checkBoolFieldInheritance"
                                    >
                                        <template #content="props">
                                            <sw-checkbox-field
                                                name="StapeConversionTracking.config.refundWebhook"
                                                :mapInheritance="props"
                                                :label="$tc('stape-server-gtm.settingForm.credentials.webHooks.refundWebhook.label')"
                                                :helpText="$tc('stape-server-gtm.settingForm.credentials.webHooks.refundWebhook.tooltipText')"
                                                :disabled="!actualConfigData['StapeConversionTracking.config.sendWebhooks']"
                                                :value="props.currentValue"
                                                @update:value="props.updateCurrentValue"
                                            />
                                        </template>
                                    </sw-inherit-wrapper>
<sw-button-process
                                        v-model:processSuccess="isTestLiveSuccessful"
                                        class="card-pointe-settings-credentials-fields__test-button"
                                        :isLoading="isLoading"
                                        variant="contrast"
                                        size="small"
                                        :square="false"
                                        :block="false"
                                        :disabled="!actualConfigData['StapeConversionTracking.config.sendWebhooks']"
                                        @click="sendTestWebhook"
                                    >
                                        {{ $tc('stape-server-gtm.settingForm.credentials.webHooks.sendTestWebhook.label') }}
                                    </sw-button-process>
</div>
</sw-container>
</sw-card>
</div>
